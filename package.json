{
  "name": "bmo-v2",
  "private": true,
  "version": "0.1.0",
  "description": "BMO V2 desktop assistant",
  "author": "BMO",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "backend:dev": "python backend/bmo_backend.py",
    "electron": "electron .",
    "electron:build": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.12.3",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "electron": "^42.3.0",
    "electron-builder": "^26.8.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.59.2",
    "vite": "^8.0.12"
  },
  "build": {
    "appId": "com.bmo.v2.desktop",
    "productName": "BMO-V2",
    "directories": {
      "output": "electron-release"
    },
    "afterPack": "build-support/after-pack.cjs",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "backend/**/*",
      "bridge/dist/**/*",
      "bridge/package.json",
      "public/**/*",
      "ui/assets/**/*",
      "SOUL.md",
      "README.md",
      "NANOBOT_LICENSE",
      "NANOBOT_THIRD_PARTY_NOTICES.md",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "runtime",
        "to": "runtime"
      },
      {
        "from": "build-support/redist",
        "to": "redist"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build-support/icon.ico",
      "artifactName": "BMO-V2-v${version}-${arch}-setup.${ext}",
      "signAndEditExecutable": false,
      "signExts": [
        "!.exe"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "BMO-V2",
      "include": "build-support/electron-installer.nsh"
    }
  }
}
